# Copy to .env and fill in. NEVER commit .env or paste private keys anywhere.

# ---- Whitechain Sepolia (chain 1874) ----
WC_RPC_URL=https://rpc.testnet.whitechain.io
WC_RPC_FALLBACK=https://rpc.ankr.com/whitechain_testnet
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
DEPLOYER_PK=
RELAYER_PKS=
ORDER_SIGNER_PK=
ROUTER_ADDRESS=
REGISTRY_ADDRESS=

# ---- ENS (Ethereum Sepolia, ENSv2) ----
SEPOLIA_RPC_URL=
ENS_ADMIN_PK=
ENS_PARENT=wondrpay.eth
ENS_USER_REGISTRY=
ENS_RESOLVER=

# ---- World ID ----
WORLD_APP_ID=
WORLD_RP_ID=
RP_SIGNING_KEY=
WORLD_ENV=staging
WORLD_IDP_CLIENT_ID=
WORLD_IDP_CLIENT_SECRET=
WORLD_IDP_ISSUER=https://auth.world.org

# ---- Arkiv (Rabdi, chain 7794095) ----
ARKIV_ACCESS_KEY=
ARKIV_WRITER_PK=

# ---- App ----
DATABASE_URL=
WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WC_PROJECT_ID=


# signs outgoing merchant webhooks (EIP-191); its address is public at /api/webhook-key
WEBHOOK_SIGNER_PK=

# rewards pool: pays scratch-card cashback (fund with test USDT; empty = offers only)
REWARDS_PK=

# ---- Protected Pay (escrow deals) ----
# optional: override the ProtectedEscrow address (default = ESCROW_ADDRESS in packages/shared/src/escrow.ts)
ESCROW_ADDRESS=
# optional: override the SplitPay address (default = SPLIT_ADDRESS in @whitepay/shared/split)
SPLIT_ADDRESS=
# ISO country codes where protected deals are switched off, e.g. "IN,US". Empty on testnet; set before real money.
DEALS_BLOCKED_COUNTRIES=
